<UserControl x:Class="FrontLineGUI.Include.Controls.ToggleSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="60" Height="30">

    <Grid>
        <ToggleButton x:Name="SwitchToggle"
                      Cursor="Hand"
                      Background="Transparent"
                      BorderThickness="0"
                      IsChecked="{Binding IsChecked, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}">

            <ToggleButton.Template>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid Width="60" Height="30">

                        <!-- Background -->
                        <Border x:Name="SwitchBackground"
                                CornerRadius="15"
                                Width="60"
                                Height="30">
                            <Border.Background>
                                <SolidColorBrush x:Name="SwitchBackgroundBrush" Color="#FFCCCCCC"/>
                            </Border.Background>
                        </Border>

                        <!-- Thumb -->
                        <Ellipse x:Name="SwitchThumb"
                                 Width="26"
                                 Height="26"
                                 Fill="White"
                                 Margin="2"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="ThumbTransform" X="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <!-- ON -->
                        <EventTrigger RoutedEvent="ToggleButton.Checked">
                            <BeginStoryboard>
                                <Storyboard>

                                    <!-- Background colour -->
                                    <ColorAnimation Storyboard.TargetName="SwitchBackgroundBrush"
                                                    Storyboard.TargetProperty="Color"
                                                    To="#FF4CD661"
                                                    Duration="0:0:0.15"/>

                                    <!-- Thumb slide -->
                                    <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                     Storyboard.TargetProperty="X"
                                                     To="30"
                                                     Duration="0:0:0.15"/>

                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <!-- OFF -->
                        <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                            <BeginStoryboard>
                                <Storyboard>

                                    <!-- Background colour -->
                                    <ColorAnimation Storyboard.TargetName="SwitchBackgroundBrush"
                                                    Storyboard.TargetProperty="Color"
                                                    To="#FFCCCCCC"
                                                    Duration="0:0:0.15"/>

                                    <!-- Thumb slide -->
                                    <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                     Storyboard.TargetProperty="X"
                                                     To="0"
                                                     Duration="0:0:0.15"/>

                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>

        </ToggleButton>
    </Grid>
</UserControl>