<UserControl x:Class="FrontLineGUI.AboutView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FrontLineGUI"
      xmlns:lang="clr-namespace:FrontLineGUI.Resources.Localization"
      xmlns:properties="clr-namespace:FrontLineGUI.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="820" d:DesignWidth="771"
     >

    <!-- Resources -->
    <UserControl.Resources>

        <!-- Converters -->
        <local:CapitalizeFirstLetterConverter x:Key="CapitalizeFirstLetterConverter" />

    </UserControl.Resources>

    <!-- Main Grid Area -->
    <Grid Background="White">

        <!-- Grid Definition -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- General -->
        <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top">

            <!-- Title -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top">
                <TextBlock Text="{ Binding Source={ x:Static lang:Strings.AboutTitle }, Converter={ StaticResource CapitalizeFirstLetterConverter }}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" TextDecorations="Underline" Foreground="#FF323232" Margin="0,10,0,0" />
                <TextBlock TextWrapping="WrapWithOverflow" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="#FF323232" Margin="10,5,10,0" Text="{ x:Static lang:Strings.AboutPreInfo }" TextAlignment="Center" FontSize="12" />
            </StackPanel>

            <!-- Content -->
            <!-- ListView used because it gives us the ability to design everything we need -->
            <!-- https://learn.microsoft.com/en-us/dotnet/api/system.windows.controls.listview?redirectedfrom=MSDN&view=windowsdesktop-7.0 -->
            <DataGrid Name = "dataGrid" AlternatingRowBackground= "LightGray" AlternationCount="2" AutoGenerateColumns="False" CanUserReorderColumns="True" CanUserResizeColumns="True" Margin="15,10,15,0" ItemsSource="{Binding ScanItemsCollection}" >

                <DataGrid.Columns>
                    <DataGridTextColumn Header = "Name" Binding = "{Binding Name}" />
                    <DataGridTextColumn Header = "Title" Binding = "{Binding Title}" />
                    <DataGridCheckBoxColumn Header = "ReElected?" Binding = "{Binding WasReElected}"/>
                    <DataGridComboBoxColumn Header = "Party" SelectedItemBinding = "{Binding Affiliation}" />
                </DataGrid.Columns>
                
            </DataGrid>

        </StackPanel>

        <!-- Bottom Row -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Bottom Info -->
            <Grid Grid.Row="1" Background="#f9f9f9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <!-- Border -->
                <Border BorderBrush="#c5c5c5" BorderThickness="0,1,0,0" Grid.ColumnSpan="2" />

                <!-- OS Info -->
                <!-- https://www.codeproject.com/Articles/73000/Getting-Operating-System-Version-Info-Even-for-Win#_comments -->
                <!-- RPECK 23/03/2025 - Ref for binding - https://stackoverflow.com/a/845033 -->
                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="10">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,3,0" TextWrapping="Wrap" Padding="0">
                        <Hyperlink Foreground="Black" NavigateUri="{ Binding Source={x:Static properties:Settings.Default},Path=FLWeb }" RequestNavigate="ExternalLinkClick"><Run Text="{ x:Static lang:Strings.MainCopyrightButton }" /></Hyperlink> <Run Text="{ x:Static lang:Strings.AboutFLText }"/>
                    </TextBlock>
                    <Separator Opacity="0.25" Height="1" Margin="0,5,0,5" />
                    <TextBlock VerticalAlignment="Center" Margin="0" TextWrapping="Wrap" Padding="0">
                        <Run Text="{ x:Static lang:Strings.AboutFlatIconText }"/> <Hyperlink Foreground="Black" NavigateUri="{ Binding Source={x:Static properties:Settings.Default},Path=FlatIconWeb }" RequestNavigate="ExternalLinkClick"><Run Text="{ x:Static lang:Strings.AboutFlatIconHyperlink }"/></Hyperlink>
                    </TextBlock>
                </StackPanel>

            </Grid>

        </Grid>

    </Grid>
    
</UserControl>
